<div class="row">
    <div class="col-md-4 col-md-offset-4">
        <h2>Login</h2>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form method="post" action="/Account/Login">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="form-group"><label>Username</label><input name="username" class="form-control" autofocus /></div>
            <div class="form-group"><label>Password</label><input name="password" type="password" class="form-control" /></div>
            <button class="btn btn-primary btn-block">Login</button>
        </form>
        <p style="margin-top:10px">No account? <a href="/Account/Register">Register</a></p>
        <!-- test accounts: admin/admin123, jdoe/password -->
    </div>
</div>
